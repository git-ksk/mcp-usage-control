{
  "name": "mcp-usage-control-cloudflare",
  "version": "0.7.0",
  "description": "Cloudflare Durable Objects usage store for mcp-usage-control.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./worker": {
      "types": "./dist/versioned-worker.d.ts",
      "import": "./dist/versioned-worker.js",
      "default": "./dist/versioned-worker.js"
    },
    "./reconciliation": {
      "types": "./dist/reconciliation.d.ts",
      "import": "./dist/reconciliation.js",
      "default": "./dist/reconciliation.js"
    },
    "./maintenance": {
      "types": "./dist/maintenance.d.ts",
      "import": "./dist/maintenance.js",
      "default": "./dist/maintenance.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/auth.js",
    "dist/auth.js.map",
    "dist/auth.d.ts",
    "dist/auth.d.ts.map",
    "dist/worker.js",
    "dist/worker.js.map",
    "dist/worker.d.ts",
    "dist/worker.d.ts.map",
    "dist/schema.js",
    "dist/schema.js.map",
    "dist/schema.d.ts",
    "dist/schema.d.ts.map",
    "dist/versioned-worker.js",
    "dist/versioned-worker.js.map",
    "dist/versioned-worker.d.ts",
    "dist/versioned-worker.d.ts.map",
    "dist/reconciliation.js",
    "dist/reconciliation.js.map",
    "dist/reconciliation.d.ts",
    "dist/reconciliation.d.ts.map",
    "dist/reconciliation-protocol.js",
    "dist/reconciliation-protocol.js.map",
    "dist/reconciliation-protocol.d.ts",
    "dist/reconciliation-protocol.d.ts.map",
    "dist/maintenance.js",
    "dist/maintenance.js.map",
    "dist/maintenance.d.ts",
    "dist/maintenance.d.ts.map",
    "dist/maintenance-protocol.js",
    "dist/maintenance-protocol.js.map",
    "dist/maintenance-protocol.d.ts",
    "dist/maintenance-protocol.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/git-ksk/mcp-usage-control.git",
    "directory": "packages/cloudflare"
  },
  "homepage": "https://github.com/git-ksk/mcp-usage-control#readme",
  "bugs": {
    "url": "https://github.com/git-ksk/mcp-usage-control/issues"
  },
  "keywords": [
    "mcp",
    "cloudflare",
    "durable-objects",
    "usage",
    "quota",
    "credits",
    "atomic"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "node ../../scripts/pack-workspace-deps.mjs prepare",
    "postpack": "node ../../scripts/pack-workspace-deps.mjs restore"
  },
  "dependencies": {
    "mcp-usage-control": "workspace:^"
  }
}
