{
  "name": "mcp-usage-control",
  "version": "0.7.0",
  "description": "Concurrency-safe usage enforcement primitives for MCP tool execution.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/store-conformance.d.ts",
      "import": "./dist/store-conformance.js",
      "default": "./dist/store-conformance.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/observability.js",
    "dist/observability.js.map",
    "dist/observability.d.ts",
    "dist/observability.d.ts.map",
    "dist/store-conformance.js",
    "dist/store-conformance.js.map",
    "dist/store-conformance.d.ts",
    "dist/store-conformance.d.ts.map",
    "dist/progressive-store-conformance.js",
    "dist/progressive-store-conformance.js.map",
    "dist/progressive-store-conformance.d.ts",
    "dist/progressive-store-conformance.d.ts.map",
    "dist/vector-store-conformance.js",
    "dist/vector-store-conformance.js.map",
    "dist/vector-store-conformance.d.ts",
    "dist/vector-store-conformance.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/git-ksk/mcp-usage-control.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/git-ksk/mcp-usage-control#readme",
  "bugs": {
    "url": "https://github.com/git-ksk/mcp-usage-control/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "usage",
    "quota",
    "entitlements",
    "credits",
    "observability"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  }
}
