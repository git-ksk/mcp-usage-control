{
  "name": "mcp-usage-control",
  "version": "0.1.0",
  "description": "Concurrency-safe usage enforcement primitives for MCP tool execution.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./firestore": {
      "types": "./dist/firestore.d.ts",
      "import": "./dist/firestore.js",
      "default": "./dist/firestore.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/observability.js",
    "dist/observability.js.map",
    "dist/observability.d.ts",
    "dist/observability.d.ts.map",
    "dist/firestore.js",
    "dist/firestore.js.map",
    "dist/firestore.d.ts",
    "dist/firestore.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "engines": { "node": ">=20" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/git-ksk/mcp-usage-control.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/git-ksk/mcp-usage-control#readme",
  "bugs": { "url": "https://github.com/git-ksk/mcp-usage-control/issues" },
  "keywords": ["mcp", "model-context-protocol", "usage", "quota", "entitlements", "credits", "observability", "firestore"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  }
}
